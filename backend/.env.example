# Application Settings
APP_NAME="Team Project Manager API"
PROJECT_NAME="Team Project Manager API"
APP_ENV="development" # development | staging | production
DEBUG=true
API_V1_STR="/api/v1"

# Server Settings
HOST="0.0.0.0"
PORT=8000

# CORS Settings
CORS_ORIGINS="*"
BACKEND_CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"

# MySQL Database Settings
DB_HOST="127.0.0.1"
DB_PORT=3306
DB_USER="root"
DB_PASSWORD="your_mysql_password_here"
DB_NAME="team_project_manager"

# Chuỗi kết nối trực tiếp đến MySQL qua driver pymysql
DATABASE_URL="mysql+pymysql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?charset=utf8mb4"

# Security / JWT Authentication
SECRET_KEY="generate_a_random_secret_key_here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
